{
  "name": "bin-saad-billing",
  "productName": "Bin Saad Billing",
  "version": "1.0.0",
  "description": "Billing software for Bin Saad Fabrics",
  "main": "src/main/main.js",
  "private": true,
  "author": "Bin Saad Fabrics",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/core.test.js",
    "dist": "electron-builder --win --x64 --publish never",
    "dist:zip": "electron-builder --win zip --x64"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "pk.binsaad.billing",
    "productName": "Bin Saad Billing",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": true,
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Bin Saad Billing",
      "artifactName": "Bin-Saad-Billing-Setup-${version}.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "zakir1529",
        "repo": "bin-saad-billing"
      }
    ],
    "portable": {
      "artifactName": "Bin-Saad-Billing-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}